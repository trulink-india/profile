# OAuth client (Desktop or Web) — never commit real values
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional: if set, used instead of refreshing (short-lived)
GOOGLE_OAUTH_ACCESS_TOKEN=

# Google Ads API developer token + login customer (MCC) if applicable
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional MCC that manages 846-367-3842
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Target Ads account for MOTO24 location sync (trulink.in). Digits only or with dashes.
# Do not point this at 214-921-7342 — that account must stay untouched.
GOOGLE_ADS_CUSTOMER_ID=846-367-3842

# Google account email that has (or will receive) GBP manager access to MOTO24
GBP_MANAGER_EMAIL=

# Optional filters once access is approved
GBP_BUSINESS_NAME_FILTER=MOTO24
# Optional Place ID / listing ID for the Badshahpur location
GBP_LISTING_ID=

# Local status store for pending/approved/rejected access requests (file path)
GBP_ACCESS_STATUS_PATH=./.data/access-status.json
